# 로컬 전용 예시입니다. 실제 값은 커밋하거나 출력하지 않습니다.
SPRING_PROFILES_ACTIVE=local
DB_URL=jdbc:postgresql://localhost:5433/notification_service
DB_USERNAME=notification
DB_PASSWORD=replace-with-local-notification-password
SERVER_PORT=8087
EUREKA_CLIENT_ENABLED=true
EUREKA_DEFAULT_ZONE=http://localhost:8761/eureka/
ACCOUNT_JWKS_URI=http://localhost:8080/.well-known/jwks.json
ACCOUNT_INTERNAL_URL=http://localhost:8080
AI_INTERNAL_URL=http://localhost:8086
PRODUCT_QUERY_INTERNAL_URL=http://localhost:8082
KAFKA_BOOTSTRAP_SERVERS=localhost:19092
NOTIFICATION_CONSUMER_ENABLED=false
NOTIFICATION_WORKER_ENABLED=false
NOTIFICATION_SERVICE_SUBJECT=
NOTIFICATION_CLIENT_SECRET=
WEB_PUSH_ENABLED=false
VAPID_SUBJECT=mailto:replace-with-operator@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
PUSH_ENCRYPTION_KEY=

# 일반 심사/주문/배송 알림은 기존 맞춤 알림과 별도로 활성화합니다.
NOTIFICATION_BUSINESS_CONSUMER_ENABLED=false
NOTIFICATION_BUSINESS_PUSH_MAX_AGE=7d

# Monitoring의 scripts/Initialize-LocalMonitoring.ps1에서 로컬 수집 토큰을 동기화합니다.
MONITORING_SCRAPE_TOKEN=
